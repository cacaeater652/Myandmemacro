local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")

local camera = workspace.CurrentCamera
local player = Players.LocalPlayer

-------------------------------------------------
-- 🔄 GLOBAL CLEANUP
-------------------------------------------------

local shared = getgenv and getgenv() or _G

-- Stop previous grenade system
if shared.GrenadeSystemRunning then
	shared.GrenadeSystemRunning = false
end

-- Stop previous Snowball repair system
if shared.SnowballRepairRunning then
	shared.SnowballRepairRunning = false
end

-- Disconnect previous RPG listener
if shared.RPGConnection then
	pcall(function()
		shared.RPGConnection:Disconnect()
	end)
	shared.RPGConnection = nil
end

-- Disconnect previous Taser listener
if shared.TaserConnection then
	pcall(function()
		shared.TaserConnection:Disconnect()
	end)
	shared.TaserConnection = nil
end

-- Disconnect previous FOV camera connection
if shared.FOVConnection then
	pcall(function()
		shared.FOVConnection:Disconnect()
	end)
	shared.FOVConnection = nil
end

-- Disconnect previous FOV property listener
if shared.FOVPropertyConnection then
	pcall(function()
		shared.FOVPropertyConnection:Disconnect()
	end)
	shared.FOVPropertyConnection = nil
end

-- Remove old grenade blocker
pcall(function()
	ContextActionService:UnbindAction("GrenadeR1Block")
end)

-- Remove old Snowballs action
pcall(function()
	ContextActionService:UnbindAction("Snowballs")
end)

-------------------------------------------------
-- 💾 SAVE COLOR
-------------------------------------------------

local savedColor = Color3.fromRGB(255,255,255)

-------------------------------------------------
-- 💣 START GRENADE SYSTEM
-------------------------------------------------

shared.GrenadeSystemRunning = true

-------------------------------------------------
-- 🔧 TIMINGS
-------------------------------------------------

local speedDelay = 0.007
local comboHold = 0.0007
local rpgSpeed = speedDelay * 2.5
local snowballSlow = 0.032

-------------------------------------------------
-- 🖱️ CLICK
-------------------------------------------------

local function click()

	local viewport = camera.ViewportSize

	local CLICK_X = viewport.X / 2
	local CLICK_Y = viewport.Y / 2 - 15 + 14

	VirtualInputManager:SendMouseButtonEvent(
		CLICK_X,
		CLICK_Y,
		0,
		true,
		game,
		0
	)

	task.wait(speedDelay)

	VirtualInputManager:SendMouseButtonEvent(
		CLICK_X,
		CLICK_Y,
		0,
		false,
		game,
		0
	)

end

-------------------------------------------------
-- ⌨️ PRESS + CLICK
-------------------------------------------------

local function pressAndClick(key, speed)

	VirtualInputManager:SendKeyEvent(
		true,
		key,
		false,
		game
	)

	task.wait(speed)

	VirtualInputManager:SendKeyEvent(
		false,
		key,
		false,
		game
	)

	click()

end

-------------------------------------------------
-- ⭐ COMBO PRESS
-------------------------------------------------

local function comboPress(key)

	VirtualInputManager:SendKeyEvent(
		true,
		key,
		false,
		game
	)

	task.wait(comboHold)

	VirtualInputManager:SendKeyEvent(
		false,
		key,
		false,
		game
	)

	click()

end

-------------------------------------------------
-- 🎯 CROSSHAIR
-------------------------------------------------

local PlayerGui = player:WaitForChild("PlayerGui")

if PlayerGui:FindFirstChild("CrosshairGui") then
	PlayerGui.CrosshairGui:Destroy()
end

if PlayerGui:FindFirstChild("ColorUI") then
	PlayerGui.ColorUI:Destroy()
end

task.wait(1)

local viewport = camera.ViewportSize

local gui = Instance.new("ScreenGui")
gui.Name = "CrosshairGui"
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000
gui.Parent = PlayerGui

local centerX = viewport.X / 2
local centerY = viewport.Y / 2 - 15 - 45

local crosshairParts = {}

local currentColor = savedColor
local outlineColor = Color3.new(0,0,0)

local function createFrameWithOutline(
	sizeX,
	sizeY,
	posX,
	posY
)

	local outline = Instance.new("Frame")

	outline.Size = UDim2.new(
		0,
		sizeX + 2,
		0,
		sizeY + 2
	)

	outline.Position = UDim2.new(
		0,
		posX - 1,
		0,
		posY - 1
	)

	outline.BackgroundColor3 = outlineColor
	outline.BorderSizePixel = 0
	outline.Parent = gui

	local inner = Instance.new("Frame")

	inner.Size = UDim2.new(
		0,
		sizeX,
		0,
		sizeY
	)

	inner.Position = UDim2.new(
		0,
		posX,
		0,
		posY
	)

	inner.BackgroundColor3 = currentColor
	inner.BorderSizePixel = 0
	inner.Parent = gui

	table.insert(
		crosshairParts,
		inner
	)

end

createFrameWithOutline(
	2,
	2,
	centerX - 1,
	centerY - 1
)

createFrameWithOutline(
	7,
	2,
	centerX - 11,
	centerY - 1
)

createFrameWithOutline(
	7,
	2,
	centerX + 4,
	centerY - 1
)

createFrameWithOutline(
	2,
	9,
	centerX - 1,
	centerY - 13
)

createFrameWithOutline(
	2,
	9,
	centerX - 1,
	centerY + 4
)

-------------------------------------------------
-- 🎨 COLOR HELPER
-------------------------------------------------

local function updateCrosshairColor(color)

	currentColor = color
	savedColor = color

	for _, part in pairs(crosshairParts) do
		part.BackgroundColor3 = color
	end

end

-------------------------------------------------
-- 🧹 CLEAN NORMAL ACTIONS
-------------------------------------------------

ContextActionService:UnbindAction("Combo")
ContextActionService:UnbindAction("Snowballs")
ContextActionService:UnbindAction("Off")
ContextActionService:UnbindAction("Lock")

-------------------------------------------------
-- ⭐ COMBO — L3
-------------------------------------------------

local holdingL3 = false

ContextActionService:BindAction(
	"Combo",

	function(_, state)

		if state == Enum.UserInputState.Begin then

			holdingL3 = true

			comboPress(Enum.KeyCode.Four)
			comboPress(Enum.KeyCode.Five)
			comboPress(Enum.KeyCode.Six)
			comboPress(Enum.KeyCode.Seven)

			click()

			if not holdingL3 then
				comboPress(Enum.KeyCode.Two)
			end

		elseif state == Enum.UserInputState.End then

			holdingL3 = false

		end

	end,

	false,

	Enum.KeyCode.ButtonL3
)

-------------------------------------------------
-- ❄️ SNOWBALLS — R3
-- Self-repairing after cutscenes/finishers
-------------------------------------------------

local function setupSnowballs()

	ContextActionService:UnbindAction("Snowballs")

	ContextActionService:BindAction(
		"Snowballs",

		function(_, state)

			if state == Enum.UserInputState.Begin then

				pressAndClick(
					Enum.KeyCode.Eight,
					snowballSlow
				)

				pressAndClick(
					Enum.KeyCode.Nine,
					snowballSlow
				)

				pressAndClick(
					Enum.KeyCode.Two,
					snowballSlow
				)

			end

		end,

		false,

		Enum.KeyCode.ButtonR3
	)

end

-- Initial setup
setupSnowballs()

-------------------------------------------------
-- 🔄 SNOWBALL SELF-REPAIR
-------------------------------------------------

shared.SnowballRepairRunning = true

local lastCamera = workspace.CurrentCamera

task.spawn(function()

	while shared.SnowballRepairRunning do

		local currentCamera = workspace.CurrentCamera

		if currentCamera ~= lastCamera then

			lastCamera = currentCamera

			task.wait(0.5)

			if shared.SnowballRepairRunning then
				setupSnowballs()
			end

		end

		task.wait(0.1)

	end

end)

-------------------------------------------------
-- 🔧 OFF — DPadDown
-------------------------------------------------

ContextActionService:BindAction(
	"Off",

	function(_, state)

		if state == Enum.UserInputState.Begin then

			VirtualInputManager:SendKeyEvent(
				true,
				Enum.KeyCode.Two,
				false,
				game
			)

			task.wait(speedDelay)

			VirtualInputManager:SendKeyEvent(
				false,
				Enum.KeyCode.Two,
				false,
				game
			)

			click()

		end

	end,

	false,

	Enum.KeyCode.DPadDown
)

-------------------------------------------------
-- 🔒 LOCK — Y
-------------------------------------------------

local LOCK_X = viewport.X - 190
local LOCK_Y = viewport.Y - 100

ContextActionService:BindAction(
	"Lock",

	function(_, state)

		if state == Enum.UserInputState.Begin then

			VirtualInputManager:SendMouseButtonEvent(
				LOCK_X,
				LOCK_Y,
				0,
				true,
				game,
				0
			)

			task.wait(speedDelay)

			VirtualInputManager:SendMouseButtonEvent(
				LOCK_X,
				LOCK_Y,
				0,
				false,
				game,
				0
			)

		end

	end,

	false,

	Enum.KeyCode.ButtonY
)

-------------------------------------------------
-- 🚀 RPG — L1
-------------------------------------------------

local rpgDebounce = false

local rpgConnection = UserInputService.InputBegan:Connect(
	function(input)

		if input.KeyCode ~= Enum.KeyCode.ButtonL1 then
			return
		end

		if rpgDebounce then
			return
		end

		rpgDebounce = true

		task.spawn(function()

			pressAndClick(
				Enum.KeyCode.One,
				rpgSpeed
			)

			pressAndClick(
				Enum.KeyCode.R,
				rpgSpeed
			)

			pressAndClick(
				Enum.KeyCode.Two,
				rpgSpeed
			)

			rpgDebounce = false

		end)

	end
)

shared.RPGConnection = rpgConnection

-------------------------------------------------
-- ⚡ TASER — DPadRight
-------------------------------------------------

local taserDebounce = false

local taserConnection = UserInputService.InputBegan:Connect(
	function(input)

		if input.KeyCode ~= Enum.KeyCode.DPadRight then
			return
		end

		if taserDebounce then
			return
		end

		taserDebounce = true

		task.spawn(function()

			pressAndClick(
				Enum.KeyCode.Zero,
				speedDelay
			)

			pressAndClick(
				Enum.KeyCode.Two,
				speedDelay
			)

			taserDebounce = false

		end)

	end
)

shared.TaserConnection = taserConnection

-------------------------------------------------
-- 💣 GRENADE — R1
-------------------------------------------------

local grenadeWasDown = false
local grenadeBusy = false

-------------------------------------------------
-- 🛑 HIGH-PRIORITY R1 BLOCK
-------------------------------------------------

ContextActionService:BindActionAtPriority(
	"GrenadeR1Block",

	function(_, state)

		return Enum.ContextActionResult.Sink

	end,

	false,

	Enum.ContextActionPriority.High.Value + 1000,

	Enum.KeyCode.ButtonR1
)

-------------------------------------------------
-- 💣 GRENADE POLLING LOOP
-------------------------------------------------

task.spawn(function()

	while shared.GrenadeSystemRunning do

		local r1Down = false

		local success, gamepadState = pcall(function()

			return UserInputService:GetGamepadState(
				Enum.UserInputType.Gamepad1
			)

		end)

		if success and gamepadState then

			for _, input in ipairs(gamepadState) do

				if input.KeyCode == Enum.KeyCode.ButtonR1 then

					if input.UserInputState == Enum.UserInputState.Begin
						or input.UserInputState == Enum.UserInputState.Change then

						r1Down = true

					end

					break

				end

			end

		end

		if r1Down and not grenadeWasDown then

			grenadeWasDown = true

			if not grenadeBusy then

				grenadeBusy = true

				task.spawn(function()

					-------------------------------------------------
					-- SLOT 3
					-------------------------------------------------

					VirtualInputManager:SendKeyEvent(
						true,
						Enum.KeyCode.Three,
						false,
						game
					)

					task.wait(speedDelay)

					VirtualInputManager:SendKeyEvent(
						false,
						Enum.KeyCode.Three,
						false,
						game
					)

					click()

					-------------------------------------------------
					-- SLOT 2
					-------------------------------------------------

					VirtualInputManager:SendKeyEvent(
						true,
						Enum.KeyCode.Two,
						false,
						game
					)

					task.wait(speedDelay)

					VirtualInputManager:SendKeyEvent(
						false,
						Enum.KeyCode.Two,
						false,
						game
					)

					click()

					grenadeBusy = false

				end)

			end

		elseif not r1Down then

			grenadeWasDown = false

		end

		task.wait()

	end

end)

-------------------------------------------------
-- 📷 FOV LOCK — CUTSCENE SAFE
-------------------------------------------------

local TARGET_FOV = 115

-------------------------------------------------
-- APPLY FOV
-------------------------------------------------

local function applyFOV()

	local currentCamera = workspace.CurrentCamera

	if currentCamera then

		if currentCamera.FieldOfView ~= TARGET_FOV then
			currentCamera.FieldOfView = TARGET_FOV
		end

	end

end

-------------------------------------------------
-- WATCH CAMERA FOV
-------------------------------------------------

local function watchCamera(cameraToWatch)

	if not cameraToWatch then
		return
	end

	-- Disconnect previous FOV property listener
	if shared.FOVPropertyConnection then

		pcall(function()
			shared.FOVPropertyConnection:Disconnect()
		end)

	end

	-- Set FOV immediately
	cameraToWatch.FieldOfView = TARGET_FOV

	-- Keep FOV at 115
	shared.FOVPropertyConnection =
		cameraToWatch:GetPropertyChangedSignal("FieldOfView"):Connect(
			function()

				if cameraToWatch.FieldOfView ~= TARGET_FOV then
					cameraToWatch.FieldOfView = TARGET_FOV
				end

			end
		)

end

-------------------------------------------------
-- DETECT CAMERA CHANGES
-------------------------------------------------

local fovConnection =
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(
		function()

			task.wait()

			local newCamera = workspace.CurrentCamera

			if newCamera then

				newCamera.FieldOfView = TARGET_FOV

				watchCamera(newCamera)

			end

		end
	)

shared.FOVConnection = fovConnection

-------------------------------------------------
-- INITIAL FOV
-------------------------------------------------

applyFOV()
watchCamera(workspace.CurrentCamera)

-------------------------------------------------
-- 🔄 RESPAWN
-------------------------------------------------

player.CharacterAdded:Connect(function()

	task.wait(0.5)

	applyFOV()

	watchCamera(workspace.CurrentCamera)

end)
